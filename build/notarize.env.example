# M13 notarization credentials — Apple ID + app-specific password method
#
# 1. Copy this file to  build/notarize.env  (that copy is gitignored)
# 2. Fill in the three real values below
# 3. Build with:   npm run dist:signed
#
# Where these come from:
#   APPLE_ID                    -> your Apple Developer account email
#   APPLE_APP_SPECIFIC_PASSWORD -> the app-specific password you generated at
#                                  https://account.apple.com  (Sign-In & Security
#                                  -> App-Specific Passwords). Format: abcd-efgh-ijkl-mnop
#   APPLE_TEAM_ID               -> 57PW79YX2K  (already known — leave as-is)

# Your Apple Developer account email address.
export APPLE_ID="you@example.com"

# The app-specific password (NOT your normal Apple password). Keep the dashes.
export APPLE_APP_SPECIFIC_PASSWORD="abcd-efgh-ijkl-mnop"

# M13's Team ID — this is correct, no need to change it.
export APPLE_TEAM_ID="57PW79YX2K"
